# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Set to "openai" to use real AI, leave empty or "mock" for mock responses
VITE_AI_PROVIDER=mock

# For production: route AI calls through a Supabase Edge Function instead of exposing this key
VITE_OPENAI_API_KEY=sk-...

# ─── App Config ───────────────────────────────────────────────────────────────
VITE_APP_NAME=Data Engineering Mastery
VITE_APP_URL=http://localhost:5173

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Enable Supabase backend (set to "true" to use DB instead of localStorage)
VITE_ENABLE_BACKEND=false

# Enable realtime subscriptions (requires Supabase)
VITE_ENABLE_REALTIME=false

# Enable AI features (set to "true" to show AI copilot)
VITE_ENABLE_AI=false
